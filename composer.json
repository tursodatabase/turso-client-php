{
    "autoload": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "pestphp/pest": "^4.3",
        "phpstan/phpstan": "^2.1"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test:feature": "php -dextension=./target/debug/liblibsql_php.so vendor/bin/pest --group=Feature",
        "test": "php -dextension=./target/debug/liblibsql_php.so vendor/bin/pest",
        "phpstan": "vendor/bin/phpstan analyse --no-progress",
        "check": [
            "@phpstan",
            "@test"
        ]
    }
}
